{
  "name": "opencode-model-variants",
  "version": "1.0.0",
  "description": "Give your OpenCode custom providers the official treatment: reasoning tiers, capabilities and context windows from models.dev — zero per-model config.",
  "license": "MIT",
  "author": "rayn",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src/",
    "script/",
    "data/",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
